      "definition": "examples/starintel/beast/challenge-broker.star",
      "a2a_endpoint_env": "STARINTEL_A2A_CHALLENGE_BROKER_URL",
      "budget_env": "STARINTEL_WORKER_CHALLENGE_BROKER_COST_UNITS",
      "skills": ["detect-challenge", "human-in-loop", "authorized-solver", "audit"]
    },
    {
      "id": "proxy-egress",
      "star_uri": "star://starintel:beast:proxy-egress",
      "definition": "examples/starintel/beast/proxy-egress.star",
