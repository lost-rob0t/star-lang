{
  "$schema": "org.starintel/beast-worker-catalog@1",
  "version": "1.0.0",
  "a2a_protocol": "1.0.0",
  "goal_documents": 100000000,
  "authority": {
    "definitions": "lost-rob0t/star-lang",
    "configuration": "starintel-biz",
    "deployment": "starintel-infra"
  },
  "safety": {
    "public_or_authorized_sources_only": true,
    "challenge_handling": "human-or-authorized-provider",
    "proxy_evasion": "forbidden",
    "rate_limit_evasion": "forbidden",
    "preserve_original_source": true,
    "record_provenance": true
  },
  "workers": [
    {
      "id": "beast-orchestrator",
      "star_uri": "star://starintel:beast:beast-orchestrator",
      "definition": "examples/starintel/beast/beast-orchestrator.star",
      "a2a_endpoint_env": "STARINTEL_A2A_BEAST_ORCHESTRATOR_URL",
      "budget_env": "STARINTEL_WORKER_BEAST_ORCHESTRATOR_COST_UNITS",
      "skills": ["plan", "delegate", "checkpoint", "backpressure", "resume"]
    },
    {
      "id": "gov-catalog",
      "star_uri": "star://starintel:beast:gov-catalog",
      "definition": "examples/starintel/beast/gov-catalog.star",
      "a2a_endpoint_env": "STARINTEL_A2A_GOV_CATALOG_URL",
      "budget_env": "STARINTEL_WORKER_GOV_CATALOG_COST_UNITS",
      "skills": ["socrata-discovery", "ckan-discovery", "arcgis-discovery", "feed-inventory"]
    },
    {
      "id": "gov-harvester",
      "star_uri": "star://starintel:beast:gov-harvester",
      "definition": "examples/starintel/beast/gov-harvester.star",
      "a2a_endpoint_env": "STARINTEL_A2A_GOV_HARVESTER_URL",
      "budget_env": "STARINTEL_WORKER_GOV_HARVESTER_COST_UNITS",
      "skills": ["bulk-export", "incremental-fetch", "partition", "resume", "dedupe-input"]
    },
    {
      "id": "challenge-broker",
